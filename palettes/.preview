#!/usr/bin/env python3
import sys, re, os

pal = {}
for line in open(os.path.expanduser(f'~/dotfiles/palettes/{sys.argv[1]}.sh')):
    m = re.match(r'^PAL_(\w+)="(#[0-9a-fA-F]+)"', line)
    if m: pal[m[1].lower()] = m[2]

def rgb(k): h = pal[k]; return int(h[1:3],16), int(h[3:5],16), int(h[5:7],16)
def f(k): return '\033[38;2;%d;%d;%dm' % rgb(k)
def b(k): return '\033[48;2;%d;%d;%dm' % rgb(k)
R = '\033[0m'

BG = b('bg')
FG, KW, FN, ST, CM, TP = f('fg'), f('purple'), f('cyan'), f('gold'), f('comment'), f('magenta')

def ln(s=''): return BG + '  ' + s + R

print('\n'.join([
    ln(KW + 'func ' + FN + 'greet' + FG + '(name ' + TP + 'string' + FG + ') ' + TP + 'string' + FG + ' {'),
    ln(FG + '    ' + KW + 'return ' + FN + 'fmt' + FG + '.' + FN + 'Sprintf' + FG + '(' + ST + '"hello, %s"' + FG + ', name)'),
    ln(FG + '}'),
    ln(),
    ln(KW + 'func ' + FN + 'main' + FG + '() { ' + FN + 'fmt' + FG + '.' + FN + 'Println' + FG + '(' + FN + 'greet' + FG + '(' + ST + '"world"' + FG + ')) }'),
    ln(),
]))
